Menu("QUADRATICS","QUAD",3)

Lbl 3
Input "A=",A
Input "B=",B
Input "C=",C
B²-4*A*C→N
Goto SIMPLIFY        // Simplify discriminant
(-B+N)/(2*A)→D
(-B-N)/(2*A)→E
Disp "ROOTS"
Disp toString(D)
Disp toString(E)
Stop

Lbl SIMPLIFY
1→H
N→I
For(S,1,int(√(N)+.1))
If 0=fPart(round(N/S²,8))
Then
S→H
N/S²→I
End
End
// Rationalization included for full simplifier
If I=1
Then
Disp toString(H)
Else
If H=1
Then
Disp "√("+toString(I)+")"
Else
Disp toString(H)+"√("+toString(I)+")"
End
End
Stop